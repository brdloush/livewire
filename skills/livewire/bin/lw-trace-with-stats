#!/usr/bin/env bash
# Usage: lw-trace-with-stats [OPTIONS] <clojure-expr | --file <path>>
# Captures aggregate Hibernate Statistics deltas — entity loads, collection fetches,
# query execution counts — without returning actual query results.
# Useful for understanding the overall database activity pattern of a call.
clj-nrepl-eval -p "${LW_PORT:-7888}" \
  "(require '[net.brdloush.livewire.core :as lw] '[net.brdloush.livewire.query :as q] '[net.brdloush.livewire.introspect :as intro] '[net.brdloush.livewire.trace :as trace] '[net.brdloush.livewire.query-watcher :as qw] '[net.brdloush.livewire.hot-queries :as hq] '[net.brdloush.livewire.jpa-query :as jpa] '[net.brdloush.livewire.mvc :as mvc])"
if [[ "${1:-}" == "--file" ]]; then
  if [[ -z "${2:-}" ]]; then
    echo "Usage: $0 --file <path-to-clj-file>" >&2
    exit 1
  fi
  EXPR=$(<"${2}")
  EXPR=$(echo "$EXPR" | tr '\n\r' '  ' | sed 's/  */ /g; s/^ *//; s/ *$//')
  exec clj-nrepl-eval -p "${LW_PORT:-7888}" <<< "(trace/trace-with-stats ${EXPR})"
else
  exec clj-nrepl-eval -p "${LW_PORT:-7888}" <<< "(trace/trace-with-stats $1)"
fi
